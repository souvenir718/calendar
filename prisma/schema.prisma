datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ScheduleCategory {
  OTHER
  MEETING
  DAY_OFF
  AM_HALF
  PM_HALF
  BIRTHDAY_HALF
  HOLIDAY
  IMPORTANT
  PAYDAY
}

model Schedule {
  id          Int              @id @default(autoincrement())
  title       String
  date        DateTime         @db.Date
  endDate     DateTime?        @db.Date
  time        String?
  description String?
  category    ScheduleCategory @default(OTHER)
  employeeId  Int?
  employee    Employee?        @relation(fields: [employeeId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([date])
  @@index([endDate])
  @@index([employeeId])
}

model Employee {
  id         Int       @id @default(autoincrement())
  name       String
  email      String?   @unique
  joinedAt   DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  schedules Schedule[]
}
